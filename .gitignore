# Python
__pycache__/
*.py[cod]
*$py.class
*.env
venv/
env/
.venv/

# Sensitive User Profiles & Sessions (Cookies, Auth, Credentials)
profiles/
auto_poster/profiles/
**/profiles/
**/Default/
**/Cookies*
*.session

# Debug screenshots & logs
debug_screenshots/
auto_poster/debug_screenshots/
*.log

# Video / Media files (Keep Git repo lightweight)
*.mp4
*.m4v
*.mov
*.avi
*.mkv
*.wav
*.mp3
slicer/inputs/*
slicer/outputs/*
!slicer/inputs/.gitkeep
!slicer/outputs/.gitkeep
outputs/*
!outputs/.gitkeep
!outputs/PUT_YOUR_VIDEOS_HERE.txt

# Node modules
node_modules/

# Archives
*.zip
*.tar.gz
*.rar

# Runtime database state (auto-generated by script on start)
auto_poster/ghost_database.json
auto_poster/posted_history.json

# IDE & OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
